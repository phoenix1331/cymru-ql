@baseUrl = http://localhost:8000

### Clubs

# Every club, alphabetically, 20 per page. Note the X-Query-Count header.
GET {{baseUrl}}/api/clubs
Accept: application/json

###

# Clubs in one league for the current season.
GET {{baseUrl}}/api/clubs?league=cymru-premier
Accept: application/json

###

# Clubs in a league for a past season (2025/26 Cymru Premier had 12 clubs).
GET {{baseUrl}}/api/clubs?league=cymru-premier&season=2025-26&per_page=50
Accept: application/json

###

# One club, with a reference to its ground and links to related resources.
GET {{baseUrl}}/api/clubs/caernarfon-town
Accept: application/json

###

# A club's league history, newest season first, with final positions.
GET {{baseUrl}}/api/clubs/bala-town/seasons
Accept: application/json

###

# Validation errors come back as 422 JSON.
GET {{baseUrl}}/api/clubs?league=ardal-north-east
Accept: application/json

### Grounds

# Every ground, alphabetically.
GET {{baseUrl}}/api/grounds
Accept: application/json

###

# A shared ground lists both clubs that play there.
GET {{baseUrl}}/api/grounds/centre-for-sporting-excellence-ystrad-mynach
Accept: application/json

### Seasons

# Seasons, newest first. One is marked current.
GET {{baseUrl}}/api/seasons
Accept: application/json

### Leagues

# The three leagues in scope, by tier.
GET {{baseUrl}}/api/leagues
Accept: application/json

###

# One league with links to its table and clubs.
GET {{baseUrl}}/api/leagues/cymru-north
Accept: application/json

###

# Current season table, calculated from simulated results (meta.basis = results).
GET {{baseUrl}}/api/leagues/cymru-premier/table
Accept: application/json

###

# Past season table from recorded final positions (meta.basis = final_positions).
GET {{baseUrl}}/api/leagues/cymru-south/table?season=2025-26
Accept: application/json

### Distances

# The five nearest grounds to The Oval by road.
GET {{baseUrl}}/api/grounds/the-oval-caernarfon/nearby
Accept: application/json

###

# The nearest grounds used by Cymru Premier clubs this season.
GET {{baseUrl}}/api/grounds/park-hall-oswestry/nearby?league=cymru-premier&limit=3
Accept: application/json

###

# Every ground in a league, nearest first, with the total road distance:
# a club's away trips for the season.
GET {{baseUrl}}/api/grounds/the-oval-caernarfon/distances?league=cymru-premier
Accept: application/json

###

# One directed pair. Road distances can differ slightly by direction.
GET {{baseUrl}}/api/grounds/the-new-oval-holyhead/distances/newport-stadium-newport
Accept: application/json

### Fixtures

# This season's fixtures in kick off order, 20 per page.
GET {{baseUrl}}/api/fixtures
Accept: application/json

###

# One club's results so far this season.
GET {{baseUrl}}/api/fixtures?club=caernarfon-town&status=finished&per_page=50
Accept: application/json

###

# A league's fixtures between two dates.
GET {{baseUrl}}/api/fixtures?league=cymru-north&from=2026-11-01&to=2026-11-30
Accept: application/json

###

# One fixture, then its match events (kick off, goals, cards, half and full time).
GET {{baseUrl}}/api/fixtures/1
Accept: application/json

###

GET {{baseUrl}}/api/fixtures/1/events
Accept: application/json

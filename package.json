{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "prepare": "husky",
        "typecheck": "tsc --noEmit",
        "lint": "eslint resources/js",
        "codegen:schema": "php artisan lighthouse:print-schema --write --disk=codegen",
        "codegen": "npm run codegen:schema && graphql-codegen --config codegen.ts",
        "test:e2e": "playwright test"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@graphql-codegen/cli": "^8.0.0",
        "@graphql-codegen/client-preset": "^7.0.0",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.3",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.107.1",
        "graphql": "^17.1.0",
        "pusher-js": "^8.6.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "urql": "^5.0.4"
    }
}
